APP_NAME=JobOrio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Production API: https://api.joborio.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP MySQL (default local setup)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joborio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@joborio.com"
MAIL_FROM_NAME="${APP_NAME}"
JOBORIO_NOTIFICATION_EMAIL_ENABLED=true

FRONTEND_URL=http://localhost:3000
# Production site that the browser loads (PM2 / Next.js), not the API host:
# FRONTEND_URL=https://joborio.com
# CORS_ALLOWED_ORIGINS=https://joborio.com,https://www.joborio.com,https://joborio.sevenapps.in
JOBORIO_OAUTH_CALLBACK_PATH=/auth/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI="${APP_URL}/api/v1/auth/linkedin/callback"

# Cloudflare Turnstile (Dashboard → Turnstile → Add site)
# Use the same site key in frontend as NEXT_PUBLIC_TURNSTILE_SITE_KEY
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Razorpay TEST mode (Dashboard → API Keys → Test)
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_Sd0k88BoyBCTKR
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_USD_INR_RATE=83

# Auto-create platform ads when a JobOrio campaign goes live (optional)
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_ADS_API_VERSION=v21.0
LINKEDIN_ADS_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
LINKEDIN_ADS_API_VERSION=202411

JOBORIO_PPR_WEBHOOK_SECRET=dev-ppr-secret
JOBORIO_DEFAULT_PPR_RATE_USD=0.30
JOBORIO_PPR_ALLOW_NANO=false
JOBORIO_AUTO_PAYOUT_ENABLED=true
JOBORIO_EMPLOYER_PROGRAMS_AUTO_ACTIVATE=true

# Live Jobrapido XML (parsed in memory + short cache; not saved to DB)
# Admin UI: /admin/syndication-feeds — URLs stored in syndication_feeds table
JOBORIO_JOBRAPIDO_FEED_URL=https://storage.googleapis.com/jr-databox-syndication-public/syndication/aggregators/vigyapanam/jobrapido_Vigyapanam_IN.xml
JOBORIO_JOBRAPIDO_FEED_CACHE_SECONDS=900
JOBORIO_JOBRAPIDO_USE_SAMPLE_WHEN_EMPTY=true
# Optional bulk seed: Name,URL|Name2,URL2
JOBORIO_SYNDICATION_FEEDS_EXTRA=
JOBORIO_DEV_GEO_COUNTRY=IN

# Google Maps — Geocoding API (server). Frontend uses NEXT_PUBLIC_GOOGLE_MAPS_API_KEY in frontend/.env
GOOGLE_MAPS_API_KEY=
JOBORIO_GOOGLE_MAPS_ENABLED=true
JOBORIO_GEOLOCATION_TRACKING=true

VITE_APP_NAME="${APP_NAME}"
