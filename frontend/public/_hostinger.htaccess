# Upload as .htaccess in site root (rename from _hostinger.htaccess)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pretty invite URLs before the file/dir short-circuit so
  # /join/PUB…/COM…/?token=… always serves the static join shell.
  RewriteRule ^join/(?!static/)[^/]+/[^/]+/?$ /join/static/static/index.html [L,QSA]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Creator tracked links (pretty path → static shell that hops to the API)
  RewriteRule ^r/([A-Za-z0-9_-]+)/?$ /r/static/index.html [L]
  RewriteRule ^p/[^/]+/?$ /p/static/index.html [L]
  RewriteRule ^jobs/s/[^/]+/?$ /jobs/s/static/index.html [L]
  RewriteRule ^jobs/[0-9]+/?$ /jobs/static/index.html [L]
  RewriteRule ^employer/programs/[0-9]+/applications/?$ /employer/programs/static/applications/index.html [L]
  RewriteRule ^employer/programs/[0-9]+/?$ /employer/programs/static/index.html [L]
  RewriteRule ^admin/users/[0-9]+/?$ /admin/users/static/index.html [L]
  RewriteRule ^publisher/communities/[0-9]+/?$ /publisher/communities/static/index.html [L,QSA]
</IfModule>
